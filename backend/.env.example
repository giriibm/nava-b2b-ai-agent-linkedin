# Database — defaults to local SQLite for zero-config dev; use Postgres in staging/prod
DATABASE_URL=sqlite:///./nava.db
# DATABASE_URL=postgresql://nava:nava@localhost:5432/nava

# LLM Gateway
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Integrations
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_DOMAIN=login

HEYREACH_API_KEY=
HEYREACH_BASE_URL=https://api.heyreach.io/api/public

# App
APP_ENV=development
SECRET_KEY=change-me
